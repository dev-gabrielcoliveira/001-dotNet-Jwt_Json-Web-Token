{
  "openapi": "3.0.1",
  "info": {
    "title": "JwtApi",
    "version": "v1"
  },
  "paths": {
    "/Auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "senha",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "papel",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/Secure/perfil/administrador": {
      "get": {
        "tags": [
          "Secure"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/Secure/perfil/usuario": {
      "get": {
        "tags": [
          "Secure"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/Secure/home": {
      "get": {
        "tags": [
          "Secure"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Digite 'Bearer {seu_token}' para autenticação",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}